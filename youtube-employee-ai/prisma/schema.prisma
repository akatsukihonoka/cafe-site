generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 対応プラットフォーム。将来 TIKTOK / INSTAGRAM / X を追加する際はここに値を足すだけでよい。
enum PlatformType {
  YOUTUBE
}

enum ChannelStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
}

enum BriefingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum JobRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id             String   @id @default(cuid())
  supabaseAuthId String   @unique
  email          String   @unique
  createdAt      DateTime @default(now())

  channels Channel[]
}

model Channel {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformType      PlatformType
  externalChannelId String
  displayName       String
  // アクセストークン/リフレッシュトークンは平文で保存しない(lib/cryptoで暗号化した値を保存する)。
  accessTokenEnc    String
  refreshTokenEnc   String
  tokenExpiresAt    DateTime
  isActive          Boolean       @default(true)
  status            ChannelStatus @default(CONNECTED)
  connectedAt       DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  briefings    Briefing[]
  videoMetrics VideoMetricSnapshot[]
  jobRuns      JobRun[]

  @@unique([platformType, externalChannelId])
  @@index([userId])
}

model Briefing {
  id                   String         @id @default(cuid())
  channelId            String
  channel              Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targetDate           DateTime       @db.Date
  status               BriefingStatus @default(PENDING)
  yesterdaySummaryJson Json?
  todosJson            Json?
  suggestionsJson      Json?
  rawMetricsJson       Json?
  aiModel              String?
  generatedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // 同一チャンネル・同一対象日の重複生成を防ぐ(毎朝バッチの冪等性)。
  @@unique([channelId, targetDate])
  @@index([channelId])
}

model VideoMetricSnapshot {
  id           String   @id @default(cuid())
  channelId    String
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videoId      String
  date         DateTime @db.Date
  views        Int
  likes        Int
  comments     Int
  watchTimeMin Int
  impressions  Int?
  ctr          Float?

  @@unique([channelId, videoId, date])
  @@index([channelId, date])
}

model JobRun {
  id           String        @id @default(cuid())
  channelId    String?
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  jobType      String
  status       JobRunStatus
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?

  @@index([channelId])
  @@index([jobType, startedAt])
}
